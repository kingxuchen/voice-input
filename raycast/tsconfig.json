{
  "compilerOptions": {
    "lib": ["ES2024"],
    "module": "ESNext",
    "target": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "react"]
  },
  "include": ["src/**/*"]
}
